# .env のひな形。コピーして .env を作成する。
#   cp .env.example .env

# コンテナの実行ユーザー（ホストと合わせるとマウントしたディレクトリの権限問題を回避できる）
#   Linux: id -u / id -g の値を入れる
#   Windows/Mac(Docker Desktop): 既定の 1000 のままで良いことが多い
UID=1000
GID=1000

# app が待ち受けるホスト側ポート
APP_PORT=8080

# GitHub CLI コンテナ（docker/gh）用の PAT。
# .env に置くよりシェルの環境変数で渡す方が安全（任意）。
# GH_TOKEN=

# OpenWiki をローカル実行する場合の LLM プロバイダ設定。
# GitHub Actions では .env は読まれない → 同名の Secret をリポジトリに登録すること。
# GEMINI_API_KEY=
# OPENWIKI_PROVIDER=gemini
# OPENWIKI_MODEL_ID=gemini-2.5-flash

# PostgreSQL の接続情報
DB_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
