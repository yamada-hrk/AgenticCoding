# .env のひな形。コピーして .env を作成する。
#   cp .env.example .env

# コンテナの実行ユーザー（ホストと合わせるとマウントしたディレクトリの権限問題を回避できる）
#   Linux: id -u / id -g の値を入れる
#   Windows/Mac(Docker Desktop): 既定の 1000 のままで良いことが多い
UID=1000
GID=1000

# app が待ち受けるホスト側ポート
APP_PORT=8080

# PostgreSQL の接続情報
DB_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
